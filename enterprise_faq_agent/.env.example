# Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=enterprise-corp-project
GOOGLE_CLOUD_LOCATION=us-central1
LOG_LEVEL=INFO

# Gemini Model Selection
GEMINI_MODEL=gemini-3.5-flash

# Vertex AI Search (Enterprise Edition) Engine
DISCOVERY_ENGINE_PROJECT_ID=enterprise-corp-project
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_ID=your-engine-id-here
DISCOVERY_ENGINE_SERVING_CONFIG_ID=default_search

# Security & Governance: Agent Gateway
AGENT_GATEWAY_URL=https://gateway.internal.corp:8443

# Security & Governance: Model Armor (Input Sanitization & Guardrails)
MODEL_ARMOR_ENABLED=true
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=corp-faq-input-template
MODEL_ARMOR_TEMPLATE_NAME=projects/enterprise-corp-project/locations/us-central1/templates/corp-faq-input-template
MODEL_ARMOR_FAIL_CLOSED=true
